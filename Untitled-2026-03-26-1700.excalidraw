      "text": "STAR - Schema ",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "STAR - Schema ",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
      "id": "3MSHhXA4Ghetc-hoD-XxN",
      "type": "rectangle",
      "x": 780.7433387557273,
      "y": 6635.739398293219,
      "width": 292.301830619597,
      "height": 85.28673073377195,
      "angle": 0,
      "strokeColor": "#c2255c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
